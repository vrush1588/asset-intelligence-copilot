# Copy to .env.local and adjust.

# Model: ollama (local Gemma, default) | gemini (free AI Studio key) | none (keyword routing only)
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=8192

# For LLM_PROVIDER=gemini
# LLM_API_KEY=your-ai-studio-key
# LLM_MODEL=gemini-2.5-flash

# Routing: hybrid (keywords when confident, model otherwise) | llm | heuristic
COPILOT_ROUTER=hybrid

# "Today" for every answer ("right now", "last 90 days", deadlines). Set it to the date the
# question document states; the latest example scenarios say 17 Oct 2026. If unset, the copilot
# uses the day after the latest inspection in the data.
COPILOT_TODAY=2026-10-17

# Database file (default data/copilot.db)
# COPILOT_DB=data/copilot.db
